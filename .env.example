# Ambiente (prd | hml)
# Define a porta do backend e o diretorio userData, para que os apps de PRD e
# HML possam ficar abertos ao mesmo tempo sem disputar o mesmo socket nem
# sobrescrever o backend.log um do outro.
APP_ENV=prd

# Porta do backend (opcional). Sem isso: prd=8080, hml=8081.
# BACKEND_PORT=

# Conexão Oracle — MDM
MDM_USER=
MDM_PASSWORD=
MDM_CONNECT_STRING=

# Conexão Oracle — QLD
QLD_USER=
QLD_PASSWORD=
QLD_CONNECT_STRING=

# JWT
JWT_SECRET=

# SMTP (reset de senha)
SMTP_HOST=
SMTP_PORT=

# Tabelas / Schemas (sem credenciais — só identificadores)
MDM_TBL_USUARIOS=
MDM_SEQ_USUARIOS=
MDM_TBL_PRF_CADASTRO=
MDM_TBL_AUDITORIA=
MDM_SEQ_AUDITORIA=
QLD_TBL_MEDICOS=
QLD_TBL_MEDICOS_ONCO=

# Caminho do Oracle Instant Client.
# No app empacotado o Electron sobrescreve esta variavel apontando para
# resources/instantclient_19_30; ela so importa para scripts rodados a mao.
ORACLE_CLIENT_LIB_DIR=
